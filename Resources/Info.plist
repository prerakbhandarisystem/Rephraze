<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Rephraze</string>
	<key>CFBundleDisplayName</key>
	<string>Rephraze</string>
	<key>CFBundleExecutable</key>
	<string>Rephraze</string>
	<!-- Stable on purpose: the Accessibility grant is keyed to this plus the
	     code signature. Changing it means re-granting permission. -->
	<key>CFBundleIdentifier</key>
	<string>com.prerak.rephraze</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>__VERSION__</string>
	<key>CFBundleVersion</key>
	<string>__BUILD__</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<!-- No Dock icon, no app menu. Lives in the menu bar only. -->
	<key>LSUIElement</key>
	<true/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>Rephraze</string>
</dict>
</plist>
