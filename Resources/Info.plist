<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleName</key>
	<string>Rephraze</string>
	<key>CFBundleDisplayName</key>
	<string>Rephraze</string>
	<key>CFBundleExecutable</key>
	<string>Rephraze</string>
	<!-- Stable on purpose: the Accessibility grant is keyed to this plus the
	     code signature. Changing it means re-granting permission. -->
	<key>CFBundleIdentifier</key>
	<string>com.prerak.rephraze</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>__VERSION__</string>
	<key>CFBundleVersion</key>
	<string>__BUILD__</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<!-- No Dock icon, no app menu. Lives in the menu bar only. This is what
	     the app is at launch; the System section can raise the activation
	     policy afterwards for anyone who wants a Dock icon back. -->
	<key>LSUIElement</key>
	<true/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<!-- The writing-style profile exported from the Team section. Declared so
	     macOS gives the file a name in Finder and an open panel can filter for
	     it, rather than falling back to a dynamic identifier. -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.prerak.rephraze.style-profile</string>
			<key>UTTypeDescription</key>
			<string>Rephraze Writing Style</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>rephrazestyle</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>NSHumanReadableCopyright</key>
	<string>Rephraze</string>
</dict>
</plist>
